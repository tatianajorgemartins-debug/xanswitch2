# Copie este arquivo para .env.local para testar na sua máquina.
# Na Vercel, essas variáveis são configuradas no painel do projeto
# (Settings → Environment Variables) — o README explica passo a passo.

# Criada automaticamente quando você conecta um banco Neon (via Vercel Marketplace) ao projeto.
DATABASE_URL=

# Dados do seu projeto Supabase, usado para guardar as capas dos jogos e
# as capturas de tela (veja o passo a passo completo no README, seção
# "Criar o armazenamento de imagens (Supabase)").
#
# NEXT_PUBLIC_SUPABASE_URL: a "Project URL" do seu projeto Supabase
#   (Settings → Data API), algo como https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY: a chave "anon public" (mesma tela). Apesar
#   do nome começar com NEXT_PUBLIC_ (ela realmente vai pro navegador, de
#   propósito), essa chave sozinha não dá acesso a nada — é segura de expor.
# SUPABASE_SERVICE_ROLE_KEY: a chave "service_role" (mesma tela). Essa SIM
#   é secreta — tem acesso total ao projeto. NUNCA deixe essa variável
#   começar com NEXT_PUBLIC_, e nunca a compartilhe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uma senha inventada por você (qualquer texto aleatório longo serve, ex:
# gerada em 1password.com/password-generator), usada só pra confirmar que
# quem está chamando a rotina diária de manutenção (app/api/cron/keepalive)
# é realmente a Vercel, e não uma outra pessoa que descobriu essa URL.
CRON_SECRET=

# Senha que você vai digitar para entrar em /admin. Escolha algo só seu.
ADMIN_PASSWORD=

# Seu número de WhatsApp com o DDI, só números (sem espaços, +, ( ) ou -).
# Exemplo para um número do Rio de Janeiro: 5521999999999
WHATSAPP_NUMBER=

# Dados de quem RECEBE o Pix (você) — usados para gerar o QR Code de
# pagamento no modal de compra. Começam com NEXT_PUBLIC_ de propósito: essas
# variáveis PRECISAM ir para o navegador de quem está comprando, porque é lá
# que o QR Code é desenhado. Isso é seguro — nome, cidade e chave Pix não são
# segredos, é exatamente o que qualquer pessoa vê ao te mandar um Pix pelo
# app do banco dela.
#
# NEXT_PUBLIC_PIX_KEY: sua chave Pix (CPF, e-mail, telefone ou chave aleatória).
# NEXT_PUBLIC_PIX_RECEIVER_NAME: seu nome como aparece na conta do banco.
#   O padrão do Banco Central limita esse campo a 25 caracteres — se o seu
#   nome completo passar disso, abrevie (ex: "JOAO C ABREU ALEXANDRE").
#   Não use acentos (Ç, Ã, Õ etc.) — o padrão Pix não aceita.
# NEXT_PUBLIC_PIX_RECEIVER_CITY: cidade da sua conta, sem acentos, até 15
#   caracteres (ex: "NITEROI").
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_RECEIVER_NAME=
NEXT_PUBLIC_PIX_RECEIVER_CITY=

# Notificação automática de novo pedido (veja o passo a passo completo no
# README, seção "Notificação automática de novo pedido").
#
# RESEND_API_KEY: chave de API da sua conta em resend.com (Canal A — e-mail,
#   o principal, sempre ativo). Crie a conta com o MESMO e-mail que você vai
#   colocar em ORDER_NOTIFICATION_EMAIL — no plano grátis, sem verificar um
#   domínio próprio, o Resend só deixa mandar e-mail de teste pro endereço
#   usado pra criar a conta.
# ORDER_NOTIFICATION_EMAIL: pra qual e-mail o aviso de novo pedido vai.
# CALLMEBOT_API_KEY: chave de API do callmebot.com (Canal B — WhatsApp,
#   bônus opcional). Sem essa chave, o site simplesmente não tenta esse
#   canal — o e-mail continua funcionando normalmente. Usa o mesmo número
#   de WHATSAPP_NUMBER acima como destino.
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID: dados do seu bot do Telegram
#   (Canal C — outro bônus opcional, grátis e sem fila de espera, ao
#   contrário do CallMeBot). Sem essas duas variáveis, o site simplesmente
#   não tenta esse canal.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
CALLMEBOT_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
