# Copie este arquivo para .env.local para testar na sua máquina.
# Na Vercel, essas variáveis são configuradas no painel do projeto
# (Settings → Environment Variables) — o README explica passo a passo.

# Criada automaticamente quando você conecta um banco Neon (via Vercel Marketplace) ao projeto.
DATABASE_URL=

# Criada automaticamente quando você cria um Vercel Blob Store e o conecta ao projeto.
BLOB_READ_WRITE_TOKEN=

# Senha que você vai digitar para entrar em /admin. Escolha algo só seu.
ADMIN_PASSWORD=

# Seu número de WhatsApp com o DDI, só números (sem espaços, +, ( ) ou -).
# Exemplo para um número do Rio de Janeiro: 5521999999999
WHATSAPP_NUMBER=

# Dados de quem RECEBE o Pix (você) — usados para gerar o QR Code de
# pagamento no modal de compra. Começam com NEXT_PUBLIC_ de propósito: essas
# variáveis PRECISAM ir para o navegador de quem está comprando, porque é lá
# que o QR Code é desenhado. Isso é seguro — nome, cidade e chave Pix não são
# segredos, é exatamente o que qualquer pessoa vê ao te mandar um Pix pelo
# app do banco dela.
#
# NEXT_PUBLIC_PIX_KEY: sua chave Pix (CPF, e-mail, telefone ou chave aleatória).
# NEXT_PUBLIC_PIX_RECEIVER_NAME: seu nome como aparece na conta do banco.
#   O padrão do Banco Central limita esse campo a 25 caracteres — se o seu
#   nome completo passar disso, abrevie (ex: "JOAO C ABREU ALEXANDRE").
#   Não use acentos (Ç, Ã, Õ etc.) — o padrão Pix não aceita.
# NEXT_PUBLIC_PIX_RECEIVER_CITY: cidade da sua conta, sem acentos, até 15
#   caracteres (ex: "NITEROI").
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_RECEIVER_NAME=
NEXT_PUBLIC_PIX_RECEIVER_CITY=
